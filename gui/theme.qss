/* BeautyCam v2 暗色主题 */

QMainWindow, QWidget#root {
    background-color: #1e1e1e;
    color: #d4d4d4;
    font-family: "PingFang SC", "Helvetica Neue", sans-serif;
}

/* ---- 视频区 ---- */
QLabel#videoLabel {
    background-color: #000000;
    border: 1px solid #3c3c3c;
    border-radius: 6px;
}

/* ---- 分组框 ---- */
QGroupBox {
    background-color: #252526;
    border: 1px solid #3c3c3c;
    border-radius: 6px;
    margin-top: 12px;
    padding: 10px 8px 8px 8px;
    font-weight: bold;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #9cdcfe;
}

/* ---- 控件通用 ---- */
QCheckBox, QLabel, QRadioButton {
    color: #d4d4d4;
    background: transparent;
}
QCheckBox::indicator {
    width: 16px; height: 16px;
    border-radius: 3px;
    border: 1px solid #555;
    background: #2d2d30;
}
QCheckBox::indicator:checked {
    background: #0a84ff;
    border-color: #0a84ff;
}

QPushButton {
    background-color: #0e639c;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 7px 14px;
    font-weight: bold;
}
QPushButton:hover  { background-color: #1177bb; }
QPushButton:pressed { background-color: #0d5a8f; }
QPushButton:disabled { background-color: #3a3d41; color: #7f8489; }

QPushButton#dangerBtn {
    background-color: #7a2c2c;
}
QPushButton#dangerBtn:hover { background-color: #a13636; }

/* ---- 滑杆 ---- */
QSlider::groove:horizontal {
    height: 4px;
    background: #3c3c3c;
    border-radius: 2px;
}
QSlider::sub-page:horizontal {
    background: #0a84ff;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    width: 14px; height: 14px;
    margin: -6px 0;
    border-radius: 7px;
    background: #e0e0e0;
}

/* ---- 滚动区/状态栏 ---- */
QScrollArea { border: none; }
QStatusBar {
    background-color: #007acc;
    color: #ffffff;
}

/* ---- 拍照预览条 ---- */
QLabel#thumbLabel {
    background-color: #111111;
    border: 1px solid #3c3c3c;
    border-radius: 4px;
}
QLabel#thumbLabel:hover {
    border: 1px solid #0a84ff;
}
